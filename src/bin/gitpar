import argparse
import codecs
import json
import os
import platform
import posixpath
import re
import shlex
import shutil
import socket
import subprocess
import sys
import tempfile
import webbrowser

if sys.version > '3':
    from http.server import SimpleHTTPRequestHandler, HTTPServer
    from urllib.parse import parse_qs, unquote, urlparse
else:
    from SimpleHTTPServer import SimpleHTTPRequestHandler
    from BaseHTTPServer import HTTPServer
    from urllib import unquote
    from urlparse import parse_qs, urlparse




IS_WINDOWS = platform.system() == "Windows"




class GitParHttpServer(HTTPServer):
    def __init__(self, server_address, RequestHandlerClass, bind_and_activate = True):
        if not isinstance(server_address, tuple) or len(server_address) < 2:
            raise TypeError("server_address must be a tuple (address,port)")
        host = server_address[0]
        port = server_address[1]
        if host is None or host == "":
            HTTPServer.__init__(self, server_address, RequestHandlerClass, bind_and_activate)
        else:
            address_info = socket.getaddrinfo(host, port, 0, 0, socket.IPPROTO_TCP)[0]
            self.address_family = address_info[0]
            HTTPServer.__init__(self, address_info[4], RequestHandlerClass, bind_and_activate)




class GitParRequestHandler(SimpleHTTPRequestHandler):

    # SimpleHTTPRequestHandler falls back to the stdlib mimetypes module
    # for anything not listed here, which in turn depends on OS-provided
    # mime.types files that aren't guaranteed to exist (minimal
    # containers, some packaged/frozen environments) - a missing or
    # wrong entry for .css is served as a generic type that browsers
    # refuse to apply as a stylesheet, silently leaving the page
    # unstyled. Pin the extensions this app actually serves so behavior
    # doesn't depend on the host's mime database.
    extensions_map = dict(SimpleHTTPRequestHandler.extensions_map, **{
        ".css": "text/css",
        ".js": "application/javascript",
        ".json": "application/json",
        ".svg": "image/svg+xml",
        ".png": "image/png",
        ".ico": "image/x-icon",
        ".woff": "font/woff",
        ".woff2": "font/woff2",
        ".ttf": "font/ttf",
        ".eot": "application/vnd.ms-fontobject",
    })

    WEB_ROOT = None
    REPO_ROOT = None
    APP_STATE_PATH = None
    RECENT_REPOS = []
    WORKSPACE_ROOT = None
    RECENT_WORKSPACES = []
    # Repos currently open as tabs, in tab order. REPO_ROOT (above) is
    # whichever one of these is the active tab for the current request -
    # see _apply_request_repo_context(), called once per request. The
    # server is single-threaded (one request handled at a time), so
    # flipping this class attribute per-request is safe.
    OPEN_REPOS = []

    @classmethod
    def initialize(cls, repo_root):
        GitParRequestHandler.WEB_ROOT = resolve_web_root()
        GitParRequestHandler.APP_STATE_PATH = os.path.join(get_app_state_dir(), "state.json")
        GitParRequestHandler.load_state()
        for restored_repo in list(GitParRequestHandler.OPEN_REPOS):
            if not os.path.isdir(restored_repo):
                GitParRequestHandler.OPEN_REPOS.remove(restored_repo)
        if repo_root:
            GitParRequestHandler.open_repo(repo_root)
        elif GitParRequestHandler.OPEN_REPOS:
            GitParRequestHandler.REPO_ROOT = GitParRequestHandler.OPEN_REPOS[0]

    @classmethod
    def load_state(cls):
        cls.RECENT_REPOS = []
        cls.RECENT_WORKSPACES = []
        cls.WORKSPACE_ROOT = None
        cls.OPEN_REPOS = []
        state_path = cls.APP_STATE_PATH
        if not state_path:
            return
        if not os.path.exists(state_path):
            # The config directory was renamed along with the app. Fall
            # back to the old one once, so an existing install keeps its
            # open repos instead of starting empty. Nothing is written
            # back there - the next save lands in the new location.
            legacy_path = legacy_app_state_path()
            if not legacy_path or not os.path.exists(legacy_path):
                return
            state_path = legacy_path
        try:
            with open(state_path, "r") as state_file:
                state = json.load(state_file)
            recent_repos = state.get("recent_repos", [])
            cls.RECENT_REPOS = [repo for repo in recent_repos if os.path.isdir(repo)]
            recent_workspaces = state.get("recent_workspaces", [])
            cls.RECENT_WORKSPACES = [workspace for workspace in recent_workspaces if os.path.isdir(workspace)]
            workspace_root = state.get("workspace_root")
            if workspace_root and os.path.isdir(workspace_root):
                cls.WORKSPACE_ROOT = os.path.realpath(workspace_root)
            open_repos = state.get("open_repos", [])
            cls.OPEN_REPOS = [repo for repo in open_repos if os.path.isdir(repo)]
        except Exception:
            cls.RECENT_REPOS = []
            cls.RECENT_WORKSPACES = []
            cls.WORKSPACE_ROOT = None
            cls.OPEN_REPOS = []

    @classmethod
    def save_state(cls):
        if not cls.APP_STATE_PATH:
            return
        state_dir = os.path.dirname(cls.APP_STATE_PATH)
        if not os.path.isdir(state_dir):
            os.makedirs(state_dir)
        state = {
            "recent_repos": cls.RECENT_REPOS[:10],
            "recent_workspaces": cls.RECENT_WORKSPACES[:10],
            "workspace_root": cls.WORKSPACE_ROOT,
            "open_repos": cls.OPEN_REPOS,
        }
        with open(cls.APP_STATE_PATH, "w") as state_file:
            json.dump(state, state_file)

    @classmethod
    def set_repo_root(cls, repo_root, persist=True):
        cls.REPO_ROOT = repo_root
        if persist and repo_root:
            repo_root = os.path.realpath(repo_root)
            cls.RECENT_REPOS = [repo for repo in cls.RECENT_REPOS if repo != repo_root and os.path.isdir(repo)]
            cls.RECENT_REPOS.insert(0, repo_root)
            cls.save_state()

    @classmethod
    def open_repo(cls, repo_root):
        """Open repo_root as a tab (or focus it if already open) and make it active."""
        repo_root = os.path.realpath(repo_root)
        cls.set_repo_root(repo_root, persist=True)
        if repo_root not in cls.OPEN_REPOS:
            cls.OPEN_REPOS.append(repo_root)
        cls.save_state()
        return repo_root

    @classmethod
    def close_repo(cls, repo_root):
        """Close a repo tab. Returns the repo_root that should become active, or None."""
        repo_root = os.path.realpath(repo_root)
        cls.OPEN_REPOS = [repo for repo in cls.OPEN_REPOS if repo != repo_root]
        cls.save_state()
        if cls.REPO_ROOT == repo_root:
            cls.REPO_ROOT = cls.OPEN_REPOS[0] if cls.OPEN_REPOS else None
        return cls.REPO_ROOT

    @classmethod
    def get_open_repo_entries(cls):
        entries = []
        for repo in cls.OPEN_REPOS:
            if os.path.isdir(repo):
                entries.append(get_repo_summary(repo, active=(repo == cls.REPO_ROOT)))
        return entries

    @classmethod
    def set_workspace_root(cls, workspace_root, persist=True):
        cls.WORKSPACE_ROOT = os.path.realpath(workspace_root) if workspace_root else None
        if persist and cls.WORKSPACE_ROOT:
            cls.RECENT_WORKSPACES = [
                workspace for workspace in cls.RECENT_WORKSPACES
                if workspace != cls.WORKSPACE_ROOT and os.path.isdir(workspace)
            ]
            cls.RECENT_WORKSPACES.insert(0, cls.WORKSPACE_ROOT)
            cls.save_state()

    @classmethod
    def get_recent_repo_entries(cls):
        entries = []
        for repo in cls.RECENT_REPOS:
            if os.path.isdir(repo):
                entries.append({
                    "name": os.path.basename(repo) or repo,
                    "path": repo,
                    "active": repo == cls.REPO_ROOT,
                })
        return entries

    @classmethod
    def get_recent_workspace_entries(cls):
        entries = []
        for workspace in cls.RECENT_WORKSPACES:
            if os.path.isdir(workspace):
                entries.append({
                    "name": os.path.basename(workspace) or workspace,
                    "path": workspace,
                    "active": workspace == cls.WORKSPACE_ROOT,
                })
        return entries

    def get_repo_context(self):
        repo_root = GitParRequestHandler.REPO_ROOT
        repo_name = os.path.basename(repo_root) if repo_root else ""
        workspace_root = GitParRequestHandler.WORKSPACE_ROOT
        workspace_repos = []
        if not self.is_view_only() and workspace_root:
            workspace_repos = scan_workspace_repos(workspace_root, repo_root)
        context = {
            "repo_id": repo_root,
            "repo_name": repo_name,
            "repo_path": repo_root if not self.is_view_only() else None,
            "has_repo": repo_root is not None,
            "recent_repos": [] if self.is_view_only() else GitParRequestHandler.get_recent_repo_entries(),
            "open_repos": [] if self.is_view_only() else GitParRequestHandler.get_open_repo_entries(),
            "workspace_path": workspace_root if not self.is_view_only() else None,
            "recent_workspaces": [] if self.is_view_only() else GitParRequestHandler.get_recent_workspace_entries(),
            "workspace_repos": workspace_repos,
            "view_only": self.is_view_only(),
            "hostname": socket.gethostname(),
        }
        return context


    def apply_request_repo_context(self):
        """Resolve which open repo this request targets from a `repo` query
        param (present on every API call once more than one repo is open)
        and make it the active GitParRequestHandler.REPO_ROOT for the
        duration of this request. Falls back to whatever REPO_ROOT already
        is when no `repo` param is given, or when it doesn't name a
        currently open repo."""
        parsed = urlparse(self.path)
        self.request_path = parsed.path
        requested = parse_qs(parsed.query).get("repo", [None])[0]
        if requested and requested in GitParRequestHandler.OPEN_REPOS:
            GitParRequestHandler.REPO_ROOT = requested


    def translate_path(self, path):
        # abandon query parameters
        path = path.split('?',1)[0]
        path = path.split('#',1)[0]
        # Don't forget explicit trailing slash when normalizing. Issue17324
        trailing_slash = True if path.rstrip().endswith('/') else False
        path = posixpath.normpath(unquote(path))
        words = path.split('/')
        words = filter(None, words)
        path = GitParRequestHandler.WEB_ROOT
        for word in words:
            drive, word = os.path.splitdrive(word)
            head, word = os.path.split(word)
            if word in (os.curdir, os.pardir): continue
            path = os.path.join(path, word)
        if trailing_slash:
            path += '/'
        return path


    def do_GET(self):
        self.apply_request_repo_context()
        if self.request_path == "/api/context":
            self.send_json(200, self.get_repo_context())
        elif self.path.startswith("/api/fs/list"):
            if self.is_view_only():
                self.send_error(403)
                return
            parsed_path = urlparse(self.path)
            requested_path = parse_qs(parsed_path.query).get("path", [None])[0]
            self.send_json(200, list_directory_entries(requested_path, GitParRequestHandler.REPO_ROOT))
        elif self.request_path == "/api/workspaces/current":
            if self.is_view_only():
                self.send_error(403)
                return
            self.send_json(200, get_workspace_payload(GitParRequestHandler.WORKSPACE_ROOT, GitParRequestHandler.REPO_ROOT))
        elif self.request_path == "/api/branches":
            if not self.ensure_repo_selected():
                return
            self.send_json(200, {
                "branches": get_branch_entries(GitParRequestHandler.REPO_ROOT),
                "tags": get_tag_entries(GitParRequestHandler.REPO_ROOT),
                "stashes": get_stash_entries(GitParRequestHandler.REPO_ROOT),
            })
        elif self.request_path == "/api/remotes":
            if not self.ensure_repo_selected():
                return
            result = list_remotes(GitParRequestHandler.REPO_ROOT)
            self.send_json(result["status"], result["payload"])
        elif self.request_path.startswith("/api/commits/") and self.request_path.endswith("/is-ancestor"):
            if not self.ensure_repo_selected():
                return
            commit = self.request_path[len("/api/commits/"):-len("/is-ancestor")]
            self.send_json(200, {"is_ancestor": is_ancestor_of_head(GitParRequestHandler.REPO_ROOT, commit)})
        elif self.request_path == "/api/worktrees":
            if self.is_view_only() or not self.ensure_repo_selected():
                self.send_error(403 if self.is_view_only() else 409)
                return
            result = list_worktrees(GitParRequestHandler.REPO_ROOT)
            self.send_json(result["status"], result["payload"])
        elif self.request_path == "/api/stashes":
            if self.is_view_only() or not self.ensure_repo_selected():
                self.send_error(403 if self.is_view_only() else 409)
                return
            result = list_stashes(GitParRequestHandler.REPO_ROOT)
            self.send_json(result["status"], result["payload"])
        elif self.path.startswith("/api/reflog"):
            if self.is_view_only() or not self.ensure_repo_selected():
                self.send_error(403 if self.is_view_only() else 409)
                return
            parsed_path = urlparse(self.path)
            ref = parse_qs(parsed_path.query).get("ref", [None])[0]
            result = list_reflog(GitParRequestHandler.REPO_ROOT, ref)
            self.send_json(result["status"], result["payload"])
        elif self.request_path == "/api/submodules":
            if self.is_view_only() or not self.ensure_repo_selected():
                self.send_error(403 if self.is_view_only() else 409)
                return
            result = list_submodules(GitParRequestHandler.REPO_ROOT)
            self.send_json(result["status"], result["payload"])
        elif self.request_path == "/api/conflicts":
            if self.is_view_only() or not self.ensure_repo_selected():
                self.send_error(403 if self.is_view_only() else 409)
                return
            result = get_conflict_status(GitParRequestHandler.REPO_ROOT)
            self.send_json(result["status"], result["payload"])
        elif self.path.startswith("/api/blame"):
            if self.is_view_only() or not self.ensure_repo_selected():
                self.send_error(403 if self.is_view_only() else 409)
                return
            parsed_path = urlparse(self.path)
            query = parse_qs(parsed_path.query)
            result = get_blame(
                GitParRequestHandler.REPO_ROOT,
                query.get("path", [None])[0],
                query.get("rev", [None])[0],
            )
            self.send_json(result["status"], result["payload"])
        elif self.request_path.startswith("/git/cat-file/"):
            if not self.ensure_repo_selected():
                return
            obj = self.request_path[14:]
            self.process(["git", "-c", "color.ui=false", "cat-file", "-p", obj], b"", True, False)
        elif self.request_path == "/dirname":
            wc = os.path.split(GitParRequestHandler.REPO_ROOT)[1] if GitParRequestHandler.REPO_ROOT else ""
            self.send_text(200, codecs.encode(wc, "utf-8"))
        elif self.request_path == "/hostname":
            self.send_text(200, codecs.encode(socket.gethostname(), "utf-8"))
        elif self.request_path == "/viewonly":
            vo = "1" if self.is_view_only() else "0"
            self.send_text(200, codecs.encode(vo, "utf-8"))
        else:
            SimpleHTTPRequestHandler.do_GET(self)


    def do_POST(self):
        self.apply_request_repo_context()
        if self.request_path == "/api/repos/select" or self.request_path == "/api/repos/open":
            if self.is_view_only():
                self.send_error(403)
                return
            payload = self.read_json_body()
            selected_path = payload.get("path")
            repo_root = resolve_repo_root(selected_path)
            if repo_root is None:
                self.send_json(400, {"error": "No git repository found at the selected path."})
                return
            GitParRequestHandler.open_repo(repo_root)
            self.send_json(200, self.get_repo_context())
        elif self.request_path == "/api/repos/close":
            if self.is_view_only():
                self.send_error(403)
                return
            payload = self.read_json_body()
            repo_root = payload.get("repo_id") or payload.get("path")
            if not repo_root:
                self.send_json(400, {"error": "A repo_id is required."})
                return
            GitParRequestHandler.close_repo(repo_root)
            self.send_json(200, self.get_repo_context())
        elif self.request_path == "/api/fs/pick-directory":
            if self.is_view_only():
                self.send_error(403)
                return
            payload = self.read_json_body()
            result = pick_directory_path(
                payload.get("path"),
                payload.get("title"),
                GitParRequestHandler.REPO_ROOT,
            )
            self.send_json(result["status"], result["payload"])
        elif self.request_path == "/api/workspaces/select":
            if self.is_view_only():
                self.send_error(403)
                return
            payload = self.read_json_body()
            selected_path = payload.get("path")
            workspace_root = os.path.realpath(os.path.expanduser(selected_path)) if selected_path else None
            if workspace_root is None or not os.path.isdir(workspace_root):
                self.send_json(400, {"error": "No directory found at the selected path."})
                return
            GitParRequestHandler.set_workspace_root(workspace_root)
            workspace_repos = scan_workspace_repos(workspace_root, GitParRequestHandler.REPO_ROOT)
            if len(workspace_repos) > 0 and not any(repo["active"] for repo in workspace_repos):
                GitParRequestHandler.set_repo_root(workspace_repos[0]["path"])
            self.send_json(200, self.get_repo_context())
        elif self.request_path == "/api/branches/checkout":
            if self.is_view_only():
                self.send_error(403)
                return
            if not self.ensure_repo_selected():
                return
            payload = self.read_json_body()
            result = checkout_branch(GitParRequestHandler.REPO_ROOT, payload.get("local_name"), payload.get("remote_name"))
            self.send_json(result["status"], result["payload"])
        elif self.request_path == "/api/branches/create":
            if self.is_view_only():
                self.send_error(403)
                return
            if not self.ensure_repo_selected():
                return
            payload = self.read_json_body()
            result = create_branch(
                GitParRequestHandler.REPO_ROOT,
                payload.get("name"),
                payload.get("start_point"),
                payload.get("checkout", True),
            )
            self.send_json(result["status"], result["payload"])
        elif self.request_path == "/api/branches/delete":
            if self.is_view_only():
                self.send_error(403)
                return
            if not self.ensure_repo_selected():
                return
            payload = self.read_json_body()
            result = delete_branch(GitParRequestHandler.REPO_ROOT, payload.get("local_name"), payload.get("force", False))
            self.send_json(result["status"], result["payload"])
        elif self.request_path == "/api/branches/compare":
            if not self.ensure_repo_selected():
                return
            payload = self.read_json_body()
            result = compare_branches(
                GitParRequestHandler.REPO_ROOT,
                payload.get("source_ref"),
                payload.get("target_ref"),
            )
            self.send_json(result["status"], result["payload"])
        elif self.request_path == "/api/branches/merge":
            if self.is_view_only():
                self.send_error(403)
                return
            if not self.ensure_repo_selected():
                return
            payload = self.read_json_body()
            result = merge_branch(
                GitParRequestHandler.REPO_ROOT,
                payload.get("source_ref"),
                payload.get("target_ref"),
                False,
            )
            self.send_json(result["status"], result["payload"])
        elif self.request_path == "/api/branches/squash-merge":
            if self.is_view_only():
                self.send_error(403)
                return
            if not self.ensure_repo_selected():
                return
            payload = self.read_json_body()
            result = merge_branch(
                GitParRequestHandler.REPO_ROOT,
                payload.get("source_ref"),
                payload.get("target_ref"),
                True,
            )
            self.send_json(result["status"], result["payload"])
        elif self.request_path == "/api/remotes/add":
            if self.is_view_only():
                self.send_error(403)
                return
            if not self.ensure_repo_selected():
                return
            payload = self.read_json_body()
            result = add_remote(GitParRequestHandler.REPO_ROOT, payload.get("name"), payload.get("url"))
            self.send_json(result["status"], result["payload"])
        elif self.request_path == "/api/remotes/remove":
            if self.is_view_only():
                self.send_error(403)
                return
            if not self.ensure_repo_selected():
                return
            payload = self.read_json_body()
            result = remove_remote(GitParRequestHandler.REPO_ROOT, payload.get("name"))
            self.send_json(result["status"], result["payload"])
        elif self.request_path == "/api/repos/clone":
            if self.is_view_only():
                self.send_error(403)
                return
            payload = self.read_json_body()
            result = clone_repo(payload.get("url"), payload.get("destination"), payload.get("directory_name"))
            if result["status"] == 200:
                GitParRequestHandler.open_repo(result["payload"]["path"])
                self.send_json(200, self.get_repo_context())
            else:
                self.send_json(result["status"], result["payload"])
        elif self.request_path == "/api/repos/create":
            if self.is_view_only():
                self.send_error(403)
                return
            payload = self.read_json_body()
            result = create_repo(payload.get("destination"), payload.get("directory_name"))
            if result["status"] == 200:
                GitParRequestHandler.open_repo(result["payload"]["path"])
                self.send_json(200, self.get_repo_context())
            else:
                self.send_json(result["status"], result["payload"])
        elif self.request_path == "/api/worktrees/add":
            if self.is_view_only() or not self.ensure_repo_selected():
                self.send_error(403 if self.is_view_only() else 409)
                return
            payload = self.read_json_body()
            result = add_worktree(
                GitParRequestHandler.REPO_ROOT,
                payload.get("path"),
                payload.get("branch"),
                payload.get("create_branch", False),
                payload.get("start_point"),
            )
            self.send_json(result["status"], result["payload"])
        elif self.request_path == "/api/worktrees/remove":
            if self.is_view_only() or not self.ensure_repo_selected():
                self.send_error(403 if self.is_view_only() else 409)
                return
            payload = self.read_json_body()
            result = remove_worktree(GitParRequestHandler.REPO_ROOT, payload.get("path"), payload.get("force", False))
            self.send_json(result["status"], result["payload"])
        elif self.request_path == "/api/stashes/apply":
            if self.is_view_only() or not self.ensure_repo_selected():
                self.send_error(403 if self.is_view_only() else 409)
                return
            payload = self.read_json_body()
            result = apply_stash(GitParRequestHandler.REPO_ROOT, payload.get("ref"), payload.get("pop", False))
            self.send_json(result["status"], result["payload"])
        elif self.request_path == "/api/stashes/drop":
            if self.is_view_only() or not self.ensure_repo_selected():
                self.send_error(403 if self.is_view_only() else 409)
                return
            payload = self.read_json_body()
            result = drop_stash(GitParRequestHandler.REPO_ROOT, payload.get("ref"))
            self.send_json(result["status"], result["payload"])
        elif self.request_path == "/api/submodules/update":
            if self.is_view_only() or not self.ensure_repo_selected():
                self.send_error(403 if self.is_view_only() else 409)
                return
            payload = self.read_json_body()
            result = update_submodules(GitParRequestHandler.REPO_ROOT, payload.get("init", True))
            self.send_json(result["status"], result["payload"])
        elif self.request_path == "/api/gitignore/add":
            if self.is_view_only() or not self.ensure_repo_selected():
                self.send_error(403 if self.is_view_only() else 409)
                return
            payload = self.read_json_body()
            result = add_to_gitignore(GitParRequestHandler.REPO_ROOT, payload.get("pattern"))
            self.send_json(result["status"], result["payload"])
        elif self.request_path == "/api/conflicts/resolve":
            if self.is_view_only() or not self.ensure_repo_selected():
                self.send_error(403 if self.is_view_only() else 409)
                return
            payload = self.read_json_body()
            result = resolve_conflict(GitParRequestHandler.REPO_ROOT, payload.get("path"), payload.get("resolution"))
            self.send_json(result["status"], result["payload"])
        elif self.request_path == "/api/rebase/plan":
            if self.is_view_only() or not self.ensure_repo_selected():
                self.send_error(403 if self.is_view_only() else 409)
                return
            payload = self.read_json_body()
            result = run_interactive_rebase_plan(GitParRequestHandler.REPO_ROOT, payload.get("base"), payload.get("actions"))
            self.send_json(result["status"], result["payload"])
        elif self.request_path == "/git":
            if not self.ensure_repo_selected():
                return
            content_length = int(self.headers["Content-Length"])
            content = self.rfile.read(content_length)
            # Convention : First line = git arguments, rest = git process stdin
            i = content.find(b'\n')
            if i != -1:
                args = content[:i]
                stdin = content[i + 1:]
            else:
                args = content
                stdin = b""
            if sys.version > '3':
                args = codecs.decode(args, "utf-8")
            cmd = shlex.split("git -c color.ui=true " + args)
            action = cmd[3]
            if not self.is_view_only() or args in ["branch", "branch --remotes", "tag"] or action in ["show", "status", "log", "ls-tree"]:
                self.process(cmd, stdin, True, True)
            else:
                self.send_error(403)
        else:
            SimpleHTTPRequestHandler.do_POST(self)


    def is_view_only(self):
        # GitPar only ever binds to the loopback interface (see main()
        # below), so every connection is local by construction. There is no
        # remote/view-only mode any more.
        return False


    def ensure_repo_selected(self):
        if GitParRequestHandler.REPO_ROOT is not None:
            return True
        self.send_json(409, {"error": "No repository is currently selected."})
        return False


    def process(self, cmd, stdin, add_headers, add_footers, env = None):
        if add_headers:
            self.send_response(200)
            self.end_headers()
        # Convention : send first all git output, then stderr.
        # Finially we add footers: a blank line followed by key / value pairs as in HTTP headers
        if IS_WINDOWS:
            # On windows we cannot pipe the process output directly to the socket.
            git = subprocess.Popen(cmd, stdin = subprocess.PIPE, stdout = subprocess.PIPE, stderr = subprocess.PIPE, cwd = GitParRequestHandler.REPO_ROOT, env = env)
            git.stdin.write(stdin)
            git.stdin.close()
            bufferlen = 64 * 1024
            while True:
                data = git.stdout.read(bufferlen)
                self.wfile.write(data)
                if len(data) < bufferlen:
                    break
            stderr = git.stderr.read()
            git.wait()
        else:
            git = subprocess.Popen(cmd, stdin = subprocess.PIPE, stdout = self.wfile, stderr = subprocess.PIPE, cwd = GitParRequestHandler.REPO_ROOT, env = env)
            stdout, stderr = git.communicate(stdin)
        if add_footers:
            self.wfile.write(stderr)
            self.wfile.write(b"\r\n")
            self.wfile.write(codecs.encode("\r\nGit-Stderr-Length: " + str(len(stderr)), "utf-8"))
            self.wfile.write(codecs.encode("\r\nGit-Return-Code: " + str(git.returncode), "utf-8"))
        elif git.returncode != 0:
            print(stderr)


    def send_text(self, http_status, text):
        self.send_response(http_status)
        self.send_header("Content-Type", "text/plain")
        self.send_header("Content-Length", len(text))
        self.end_headers()
        self.wfile.write(text)


    def send_json(self, http_status, payload):
        if sys.version > '3':
            text = json.dumps(payload).encode("utf-8")
        else:
            text = json.dumps(payload)
        self.send_response(http_status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", len(text))
        self.end_headers()
        self.wfile.write(text)


    def read_json_body(self):
        content_length = int(self.headers.get("Content-Length", 0))
        if content_length == 0:
            return {}
        content = self.rfile.read(content_length)
        if sys.version > '3':
            content = codecs.decode(content, "utf-8")
        try:
            return json.loads(content)
        except ValueError:
            return {}




def read_config_string(name, default=None):
    git = subprocess.Popen(["git", "-c", "color.ui=false", "config", "--get", "gitpar.{}".format(name)], stdout = subprocess.PIPE, stderr = subprocess.PIPE)
    out =  codecs.decode(git.communicate()[0], "utf-8")
    if git.returncode != 0:
        # The key doesn't exist
        return default
    return out.strip()




def read_config_boolean(name, default=False):
    r = read_config_string(name)
    if r == None:
        return bool(default)
    return str(r).lower() == "true"


def get_app_state_dir():
    if IS_WINDOWS:
        return os.path.join(os.environ.get("APPDATA", os.path.expanduser("~")), "gitpar")
    return os.path.join(os.path.expanduser("~"), ".config", "gitpar")


def legacy_app_state_path():
    """Where state lived before the app was renamed to GitPar.

    Read once, on first run, so an existing install doesn't lose its
    open repos to the rename. Never written to.
    """
    if IS_WINDOWS:
        base = os.path.join(os.environ.get("APPDATA", os.path.expanduser("~")), "git-webui")
    else:
        base = os.path.join(os.path.expanduser("~"), ".config", "git-webui")
    return os.path.join(base, "state.json")


def resolve_web_root():
    """Locate the share/gitpar/web static asset directory.

    Normal (unfrozen) layout: this script lives at <root>/bin/gitpar, so
    the assets are two directories up, under share/gitpar/web.

    PyInstaller onefile layout: there is no "two directories up" -
    everything is extracted to a temp dir (sys._MEIPASS) at startup.
    packaging/pyinstaller/gitpar.spec bundles the same share/gitpar/web
    tree into that temp dir, so it's found the same way, just rooted
    differently. See packaging/README.md.
    """
    if getattr(sys, "frozen", False) and hasattr(sys, "_MEIPASS"):
        return os.path.join(sys._MEIPASS, "share", "gitpar", "web")
    web_root = os.path.dirname(os.path.dirname(os.path.realpath(sys.argv[0])))
    return os.path.join(web_root, "share", "gitpar", "web")


def decode_output(data):
    if sys.version > '3' and isinstance(data, bytes):
        return codecs.decode(data, "utf-8")
    return data


def run_command_capture(command):
    try:
        process = subprocess.Popen(
            command,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        stdout, stderr = process.communicate()
        return {
            "returncode": process.returncode,
            "stdout": decode_output(stdout),
            "stderr": decode_output(stderr),
        }
    except OSError as error:
        return {
            "returncode": 1,
            "stdout": "",
            "stderr": str(error),
        }


def run_git_capture(repo_root, git_args):
    try:
        git = subprocess.Popen(
            ["git", "-c", "color.ui=false"] + git_args,
            cwd=repo_root,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        stdout, stderr = git.communicate()
        return {
            "returncode": git.returncode,
            "stdout": decode_output(stdout),
            "stderr": decode_output(stderr),
        }
    except OSError as error:
        return {
            "returncode": 1,
            "stdout": "",
            "stderr": str(error),
        }


def get_current_branch_name(repo_root):
    result = run_git_capture(repo_root, ["symbolic-ref", "--quiet", "--short", "HEAD"])
    if result["returncode"] == 0:
        return result["stdout"].strip()
    return None


def is_ancestor_of_head(repo_root, commit):
    if not commit:
        return False
    result = run_git_capture(repo_root, ["merge-base", "--is-ancestor", commit, "HEAD"])
    return result["returncode"] == 0


def normalize_directory_path(path):
    if not path:
        return None
    path = os.path.realpath(os.path.expanduser(path))
    if os.path.isdir(path):
        return path
    return None


def get_default_picker_directory(path, current_repo_root=None):
    normalized = normalize_directory_path(path)
    if normalized is not None:
        return normalized
    if current_repo_root is not None:
        repo_parent = normalize_directory_path(os.path.dirname(current_repo_root))
        if repo_parent is not None:
            return repo_parent
    return os.path.expanduser("~")


def run_tk_directory_picker(initial_dir, title):
    if not sys.executable:
        return {"returncode": 1, "stdout": "", "stderr": "Python executable unavailable."}
    if not IS_WINDOWS and not os.environ.get("DISPLAY") and not os.environ.get("WAYLAND_DISPLAY"):
        return {"returncode": 1, "stdout": "", "stderr": "No graphical desktop session detected."}
    script = (
        "import sys, tkinter as tk\n"
        "from tkinter import filedialog\n"
        "root = tk.Tk()\n"
        "root.withdraw()\n"
        "root.attributes('-topmost', True)\n"
        "path = filedialog.askdirectory(initialdir=sys.argv[1], title=sys.argv[2], mustexist=True)\n"
        "root.destroy()\n"
        "sys.stdout.write(path or '')\n"
    )
    return run_command_capture([sys.executable, "-c", script, initial_dir, title])


def run_powershell_directory_picker(initial_dir, title):
    script = (
        "Add-Type -AssemblyName System.Windows.Forms;"
        "$dialog = New-Object System.Windows.Forms.FolderBrowserDialog;"
        "$dialog.Description = $args[1];"
        "$dialog.SelectedPath = $args[0];"
        "$dialog.ShowNewFolderButton = $true;"
        "$result = $dialog.ShowDialog();"
        "if ($result -eq [System.Windows.Forms.DialogResult]::OK) { [Console]::Write($dialog.SelectedPath) }"
    )
    return run_command_capture(["powershell", "-NoProfile", "-Command", script, initial_dir, title])


def run_osascript_directory_picker(initial_dir, title):
    script = (
        "set startPath to POSIX file (item 1 of argv)\n"
        "set pickedFolder to choose folder with prompt (item 2 of argv) default location startPath\n"
        "POSIX path of pickedFolder"
    )
    return run_command_capture(["osascript", "-e", script, initial_dir, title])


def run_zenity_directory_picker(initial_dir, title):
    filename = initial_dir
    if filename and not filename.endswith(os.sep):
        filename += os.sep
    return run_command_capture([
        "zenity",
        "--file-selection",
        "--directory",
        "--title=" + title,
        "--filename=" + filename,
    ])


def run_kdialog_directory_picker(initial_dir, title):
    return run_command_capture(["kdialog", "--getexistingdirectory", initial_dir, "--title", title])


def command_exists(name):
    return shutil.which(name) is not None


def pick_directory_path(path, title, current_repo_root=None):
    initial_dir = get_default_picker_directory(path, current_repo_root)
    title = title or "Select a folder"

    results = []
    if IS_WINDOWS:
        if command_exists("powershell"):
            results.append(run_powershell_directory_picker(initial_dir, title))
        results.append(run_tk_directory_picker(initial_dir, title))
    elif platform.system() == "Darwin":
        if command_exists("osascript"):
            results.append(run_osascript_directory_picker(initial_dir, title))
        results.append(run_tk_directory_picker(initial_dir, title))
    else:
        if command_exists("zenity"):
            results.append(run_zenity_directory_picker(initial_dir, title))
        if command_exists("kdialog"):
            results.append(run_kdialog_directory_picker(initial_dir, title))

    if len(results) == 0:
        return {
            "status": 200,
            "payload": {
                "unsupported": True,
                "error": "Native folder picker unavailable. Open the manual browser instead.",
            },
        }

    errors = []
    for result in results:
        stdout = result["stdout"].strip()
        stderr = result["stderr"].strip()
        if result["returncode"] == 0:
            selected_path = normalize_directory_path(stdout)
            if selected_path is not None:
                return {
                    "status": 200,
                    "payload": {
                        "path": selected_path,
                    },
                }
            if len(stdout) == 0:
                return {
                    "status": 200,
                    "payload": {
                        "cancelled": True,
                    },
                }
        if len(stdout) == 0 and (len(stderr) == 0 or "canceled" in stderr.lower() or "cancelled" in stderr.lower()):
            return {
                "status": 200,
                "payload": {
                    "cancelled": True,
                },
            }
        if stderr:
            errors.append(stderr)

    return {
        "status": 200,
        "payload": {
            "unsupported": True,
            "error": "Native folder picker unavailable. " + (errors[0] if len(errors) > 0 else "Open the manual browser instead."),
        },
    }


def resolve_repo_root(path):
    if not path:
        return None
    path = os.path.realpath(os.path.expanduser(path))
    if not os.path.isdir(path):
        return None
    try:
        git = subprocess.Popen(
            ["git", "-c", "color.ui=false", "rev-parse", "--show-toplevel"],
            cwd=path,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        stdout = git.communicate()[0]
        if git.returncode != 0:
            return None
        if sys.version > '3':
            stdout = codecs.decode(stdout, "utf-8")
        return os.path.realpath(stdout.strip())
    except OSError:
        return None


def looks_like_git_root(path):
    return os.path.exists(os.path.join(path, ".git"))


def parse_track_details(track):
    ahead = 0
    behind = 0
    if not track:
        return ahead, behind
    track = track.strip()
    if track.startswith("[") and track.endswith("]"):
        track = track[1:-1]
    for item in track.split(","):
        item = item.strip()
        if item.startswith("ahead "):
            ahead = int(item[6:])
        elif item.startswith("behind "):
            behind = int(item[7:])
    return ahead, behind


def parse_for_each_ref_line(line):
    fields = line.split("\t")
    while len(fields) < 8:
        fields.append("")
    return {
        "name": fields[0],
        "is_current": fields[1] == "*",
        "upstream": fields[2],
        "track": fields[3],
        "date": fields[4],
        "subject": fields[5],
        "commit": fields[6],
        "full_name": fields[7],
    }


def get_tag_entries(repo_root):
    """Tags, with the commit each one resolves to.

    %(objectname) on an annotated tag is the tag object, not the commit
    it points at, so */%(objectname) is used - it dereferences annotated
    tags and is empty for lightweight ones, where objectname is already
    the commit.
    """
    result = run_git_capture(
        repo_root,
        [
            "for-each-ref",
            "--sort=-creatordate",
            "--format=%(refname:short)\t%(objectname)\t%(*objectname)\t%(creatordate:relative)",
            "refs/tags",
        ],
    )
    tags = []
    if result["returncode"] != 0:
        return tags
    for line in result["stdout"].splitlines():
        if not line.strip():
            continue
        fields = line.split("\t")
        while len(fields) < 4:
            fields.append("")
        name, objectname, peeled, date = fields[0], fields[1], fields[2], fields[3]
        commit = peeled or objectname
        if not name or not commit:
            continue
        tags.append({
            "name": name,
            "commit": commit,
            "annotated": bool(peeled),
            "last_updated": date,
        })
    return tags


def get_stash_entries(repo_root):
    """Stash entries with the commit each one is recorded as.

    `git stash list` walks the refs/stash reflog, so this covers every
    stash rather than just the most recent one the way refs/stash alone
    would. The commits are handed to the log walk so stashes show up in
    the graph beside the commits they were taken from.
    """
    result = run_git_capture(
        repo_root, ["stash", "list", "--format=%H%x09%P%x09%gd%x09%s"])
    stashes = []
    if result["returncode"] != 0:
        return stashes
    for line in result["stdout"].splitlines():
        if not line.strip():
            continue
        fields = line.split("\t")
        while len(fields) < 4:
            fields.append("")
        commit, parents, ref, message = fields[0], fields[1], fields[2], fields[3]
        if not commit:
            continue
        # A stash also records the index, and any untracked files, as
        # further parents. Those are synthetic commits reachable from
        # nothing else, so they are reported for the caller to drop -
        # a log walk seeded with the stash would otherwise list them
        # as if they were real history.
        parent_list = [p for p in parents.split(" ") if p]
        stashes.append({
            "commit": commit,
            "ref": ref,
            "message": message,
            "base": parent_list[0] if parent_list else None,
            "internal_parents": parent_list[1:],
        })
    return stashes


def get_branch_entries(repo_root):
    local_refs = run_git_capture(
        repo_root,
        [
            "for-each-ref",
            "--sort=-committerdate",
            "--format=%(refname:short)\t%(HEAD)\t%(upstream:short)\t%(upstream:track)\t%(committerdate:relative)\t%(subject)\t%(objectname)\t%(refname)",
            "refs/heads",
        ],
    )
    remote_refs = run_git_capture(
        repo_root,
        [
            "for-each-ref",
            "--sort=-committerdate",
            "--format=%(refname:short)\t%(HEAD)\t%(upstream:short)\t%(upstream:track)\t%(committerdate:relative)\t%(subject)\t%(objectname)\t%(refname)",
            "refs/remotes",
        ],
    )
    local_branches = []
    remote_map = {}
    if local_refs["returncode"] == 0:
        for line in local_refs["stdout"].splitlines():
            if line.strip():
                local_branches.append(parse_for_each_ref_line(line))
    if remote_refs["returncode"] == 0:
        for line in remote_refs["stdout"].splitlines():
            if not line.strip():
                continue
            remote_branch = parse_for_each_ref_line(line)
            if remote_branch["full_name"].endswith("/HEAD"):
                continue
            short_name = remote_branch["name"].split("/", 1)[1] if "/" in remote_branch["name"] else remote_branch["name"]
            remote_map.setdefault(short_name, []).append(remote_branch)

    branches = []
    consumed_remote_names = set()
    for local_branch in local_branches:
        local_name = local_branch["name"]
        upstream = local_branch["upstream"]
        remote_branch = None
        if upstream:
            for candidate in remote_map.get(local_name, []):
                if candidate["name"] == upstream:
                    remote_branch = candidate
                    break
        if remote_branch is None:
            candidates = remote_map.get(local_name, [])
            if len(candidates) > 0:
                remote_branch = candidates[0]
        if remote_branch is not None:
            consumed_remote_names.add(remote_branch["name"])
        ahead, behind = parse_track_details(local_branch["track"])
        branches.append({
            "display_name": local_name,
            "local_name": local_name,
            "remote_name": remote_branch["name"] if remote_branch is not None else None,
            "current": local_branch["is_current"],
            "status": "tracking" if remote_branch is not None else "local-only",
            "upstream": upstream or (remote_branch["name"] if remote_branch is not None else None),
            "ahead": ahead,
            "behind": behind,
            "last_updated": local_branch["date"] or (remote_branch["date"] if remote_branch is not None else ""),
            "subject": local_branch["subject"] or (remote_branch["subject"] if remote_branch is not None else ""),
            "commit": local_branch["commit"] or (remote_branch["commit"] if remote_branch is not None else ""),
            # The upstream's own tip, which differs from the local tip
            # whenever the branch is ahead or behind - the graph needs
            # both to place each label at the commit it points at.
            "remote_commit": remote_branch["commit"] if remote_branch is not None else None,
            "can_delete": not local_branch["is_current"],
        })

    for remote_candidates in remote_map.values():
        for remote_branch in remote_candidates:
            if remote_branch["name"] in consumed_remote_names:
                continue
            branches.append({
                "display_name": remote_branch["name"],
                "local_name": None,
                "remote_name": remote_branch["name"],
                "current": False,
                "status": "remote-only",
                "upstream": None,
                "ahead": 0,
                "behind": 0,
                "last_updated": remote_branch["date"],
                "subject": remote_branch["subject"],
                "commit": remote_branch["commit"],
                "remote_commit": remote_branch["commit"],
                "can_delete": False,
            })

    branches.sort(key=lambda branch: (not branch["current"], branch["status"] == "remote-only", branch["display_name"].lower()))
    return branches


def build_branch_action_response(repo_root, result, success_message):
    if result["returncode"] == 0:
        return {
            "status": 200,
            "payload": {
                "message": success_message,
                "branches": get_branch_entries(repo_root),
            },
        }
    return {
        "status": 400,
        "payload": {"error": result["stderr"] or result["stdout"] or "Git command failed."},
    }


def checkout_branch(repo_root, local_name, remote_name):
    if local_name:
        result = run_git_capture(repo_root, ["checkout", local_name])
        return build_branch_action_response(repo_root, result, "Checked out " + local_name)
    if remote_name:
        result = run_git_capture(repo_root, ["checkout", "--track", remote_name])
        return build_branch_action_response(repo_root, result, "Checked out " + remote_name)
    return {"status": 400, "payload": {"error": "No branch specified."}}


def create_branch(repo_root, name, start_point, checkout):
    if not name or len(name.strip()) == 0:
        return {"status": 400, "payload": {"error": "Branch name is required."}}
    name = name.strip()
    if checkout:
        command = ["checkout", "-b", name]
    else:
        command = ["branch", name]
    if start_point and len(start_point.strip()) > 0:
        command.append(start_point.strip())
    result = run_git_capture(repo_root, command)
    return build_branch_action_response(repo_root, result, "Created branch " + name)


def delete_branch(repo_root, local_name, force):
    if not local_name or len(local_name.strip()) == 0:
        return {"status": 400, "payload": {"error": "Local branch name is required."}}
    command = ["branch", "-D" if force else "-d", local_name.strip()]
    result = run_git_capture(repo_root, command)
    return build_branch_action_response(repo_root, result, "Deleted branch " + local_name.strip())


def compare_branches(repo_root, source_ref, target_ref):
    if not source_ref or len(source_ref.strip()) == 0:
        return {"status": 400, "payload": {"error": "A source branch is required for compare."}}
    source_ref = source_ref.strip()
    if not target_ref or len(target_ref.strip()) == 0:
        target_ref = get_current_branch_name(repo_root)
    if not target_ref:
        return {"status": 400, "payload": {"error": "A target branch is required for compare."}}
    target_ref = target_ref.strip()
    summary = run_git_capture(repo_root, ["diff", "--stat", target_ref + "..." + source_ref])
    diff = run_git_capture(repo_root, ["diff", target_ref + "..." + source_ref])
    if summary["returncode"] != 0 or diff["returncode"] != 0:
        return {
            "status": 400,
            "payload": {"error": summary["stderr"] or diff["stderr"] or summary["stdout"] or diff["stdout"] or "Compare failed."},
        }
    return {
        "status": 200,
        "payload": {
            "source_ref": source_ref,
            "target_ref": target_ref,
            "summary": summary["stdout"],
            "diff": diff["stdout"],
        },
    }


def merge_branch(repo_root, source_ref, target_ref, squash):
    if not source_ref or len(source_ref.strip()) == 0:
        return {"status": 400, "payload": {"error": "A source branch is required for merge."}}
    source_ref = source_ref.strip()
    current_branch = get_current_branch_name(repo_root)
    if not target_ref or len(target_ref.strip()) == 0:
        target_ref = current_branch
    if not target_ref:
        return {"status": 400, "payload": {"error": "A target branch is required for merge."}}
    target_ref = target_ref.strip()

    if current_branch != target_ref:
        checkout_result = run_git_capture(repo_root, ["checkout", target_ref])
        if checkout_result["returncode"] != 0:
            return {
                "status": 400,
                "payload": {"error": checkout_result["stderr"] or checkout_result["stdout"] or "Unable to checkout target branch."},
            }

    merge_args = ["merge"]
    if squash:
        merge_args.append("--squash")
    merge_args.append(source_ref)
    result = run_git_capture(repo_root, merge_args)
    if result["returncode"] == 0:
        return build_branch_action_response(
            repo_root,
            result,
            ("Squashed " if squash else "Merged ") + source_ref + " into " + target_ref,
        )

    return {
        "status": 409,
        "payload": {
            "error": result["stderr"] or result["stdout"] or "Git merge failed.",
            "message": ("Squash merge" if squash else "Merge") + " needs attention.",
            "branches": get_branch_entries(repo_root),
        },
    }


def list_remotes(repo_root):
    result = run_git_capture(repo_root, ["remote", "-v"])
    if result["returncode"] != 0:
        return {"status": 400, "payload": {"error": result["stderr"] or "Unable to list remotes."}}
    remotes = {}
    order = []
    for line in result["stdout"].splitlines():
        parts = line.split()
        if len(parts) < 2:
            continue
        name, url = parts[0], parts[1]
        kind = parts[2].strip("()") if len(parts) > 2 else "fetch"
        if name not in remotes:
            remotes[name] = {"name": name, "fetch_url": None, "push_url": None}
            order.append(name)
        if kind == "push":
            remotes[name]["push_url"] = url
        else:
            remotes[name]["fetch_url"] = url
    return {"status": 200, "payload": {"remotes": [remotes[name] for name in order]}}


def add_remote(repo_root, name, url):
    if not name or not name.strip():
        return {"status": 400, "payload": {"error": "Remote name is required."}}
    if not url or not url.strip():
        return {"status": 400, "payload": {"error": "Remote URL is required."}}
    result = run_git_capture(repo_root, ["remote", "add", name.strip(), url.strip()])
    if result["returncode"] != 0:
        return {"status": 400, "payload": {"error": result["stderr"] or "Unable to add remote."}}
    return list_remotes(repo_root)


def remove_remote(repo_root, name):
    if not name or not name.strip():
        return {"status": 400, "payload": {"error": "Remote name is required."}}
    result = run_git_capture(repo_root, ["remote", "remove", name.strip()])
    if result["returncode"] != 0:
        return {"status": 400, "payload": {"error": result["stderr"] or "Unable to remove remote."}}
    return list_remotes(repo_root)


def clone_repo(url, destination_parent, directory_name=None):
    if not url or not url.strip():
        return {"status": 400, "payload": {"error": "A repository URL is required."}}
    url = url.strip()
    parent = os.path.realpath(os.path.expanduser(destination_parent or "~"))
    if not os.path.isdir(parent):
        return {"status": 400, "payload": {"error": "Destination folder does not exist."}}
    name = (directory_name or "").strip()
    if not name:
        name = os.path.basename(url.rstrip("/"))
        if name.endswith(".git"):
            name = name[:-4]
    if not name:
        return {"status": 400, "payload": {"error": "Unable to determine a destination folder name."}}
    target = os.path.join(parent, name)
    if os.path.exists(target):
        return {"status": 400, "payload": {"error": target + " already exists."}}
    result = run_command_capture(["git", "clone", url, target])
    if result["returncode"] != 0:
        return {"status": 400, "payload": {"error": result["stderr"] or result["stdout"] or "Clone failed."}}
    return {"status": 200, "payload": {"path": os.path.realpath(target)}}


def create_repo(destination_parent, directory_name):
    if not directory_name or not directory_name.strip():
        return {"status": 400, "payload": {"error": "A folder name is required."}}
    parent = os.path.realpath(os.path.expanduser(destination_parent or "~"))
    if not os.path.isdir(parent):
        return {"status": 400, "payload": {"error": "Destination folder does not exist."}}
    target = os.path.join(parent, directory_name.strip())
    if os.path.exists(target):
        return {"status": 400, "payload": {"error": target + " already exists."}}
    os.makedirs(target)
    result = run_command_capture(["git", "init", target])
    if result["returncode"] != 0:
        return {"status": 400, "payload": {"error": result["stderr"] or result["stdout"] or "git init failed."}}
    return {"status": 200, "payload": {"path": os.path.realpath(target)}}


def list_worktrees(repo_root):
    result = run_git_capture(repo_root, ["worktree", "list", "--porcelain"])
    if result["returncode"] != 0:
        return {"status": 400, "payload": {"error": result["stderr"] or "Unable to list worktrees."}}
    worktrees = []
    current = None
    for line in result["stdout"].splitlines():
        if not line.strip():
            if current:
                worktrees.append(current)
                current = None
            continue
        if line.startswith("worktree "):
            current = {
                "path": line[len("worktree "):],
                "head": None,
                "branch": None,
                "detached": False,
                "locked": False,
                "prunable": False,
            }
        elif current is None:
            continue
        elif line.startswith("HEAD "):
            current["head"] = line[len("HEAD "):]
        elif line.startswith("branch "):
            current["branch"] = short_ref_name(line[len("branch "):])
        elif line == "detached":
            current["detached"] = True
        elif line.startswith("locked"):
            current["locked"] = True
        elif line.startswith("prunable"):
            current["prunable"] = True
    if current:
        worktrees.append(current)
    return {"status": 200, "payload": {"worktrees": worktrees}}


def short_ref_name(ref_name):
    if not ref_name:
        return ref_name
    for prefix in ("refs/heads/", "refs/remotes/", "refs/tags/"):
        if ref_name.startswith(prefix):
            return ref_name[len(prefix):]
    return ref_name


def add_worktree(repo_root, path, branch, create_branch, start_point):
    if not path or not path.strip():
        return {"status": 400, "payload": {"error": "A worktree path is required."}}
    target = os.path.realpath(os.path.expanduser(path.strip()))
    args = ["worktree", "add"]
    if create_branch:
        if not branch or not branch.strip():
            return {"status": 400, "payload": {"error": "A new branch name is required."}}
        args += ["-b", branch.strip(), target]
        if start_point and start_point.strip():
            args.append(start_point.strip())
    else:
        args.append(target)
        if branch and branch.strip():
            args.append(branch.strip())
    result = run_git_capture(repo_root, args)
    if result["returncode"] != 0:
        return {"status": 400, "payload": {"error": result["stderr"] or result["stdout"] or "Unable to add worktree."}}
    return list_worktrees(repo_root)


def remove_worktree(repo_root, path, force):
    if not path or not path.strip():
        return {"status": 400, "payload": {"error": "A worktree path is required."}}
    args = ["worktree", "remove"]
    if force:
        args.append("--force")
    args.append(path.strip())
    result = run_git_capture(repo_root, args)
    if result["returncode"] != 0:
        return {"status": 400, "payload": {"error": result["stderr"] or result["stdout"] or "Unable to remove worktree."}}
    return list_worktrees(repo_root)


def list_stashes(repo_root):
    result = run_git_capture(repo_root, ["stash", "list", "--pretty=format:%gd\t%an\t%ar\t%s"])
    if result["returncode"] != 0:
        return {"status": 400, "payload": {"error": result["stderr"] or "Unable to list stashes."}}
    stashes = []
    for line in result["stdout"].splitlines():
        if not line.strip():
            continue
        parts = line.split("\t")
        while len(parts) < 4:
            parts.append("")
        stashes.append({"ref": parts[0], "author": parts[1], "date": parts[2], "message": parts[3]})
    return {"status": 200, "payload": {"stashes": stashes}}


def apply_stash(repo_root, ref, pop):
    if not ref or not ref.strip():
        return {"status": 400, "payload": {"error": "A stash reference is required."}}
    result = run_git_capture(repo_root, ["stash", "pop" if pop else "apply", ref.strip()])
    if result["returncode"] != 0:
        return {"status": 400, "payload": {"error": result["stderr"] or result["stdout"] or "Unable to apply stash."}}
    return {"status": 200, "payload": {"message": result["stdout"] or "Stash applied."}}


def drop_stash(repo_root, ref):
    if not ref or not ref.strip():
        return {"status": 400, "payload": {"error": "A stash reference is required."}}
    result = run_git_capture(repo_root, ["stash", "drop", ref.strip()])
    if result["returncode"] != 0:
        return {"status": 400, "payload": {"error": result["stderr"] or "Unable to drop stash."}}
    return list_stashes(repo_root)


def list_reflog(repo_root, ref=None, limit=200):
    result = run_git_capture(
        repo_root,
        ["reflog", "show", "--date=relative", "--format=%H\t%gd\t%gs\t%ad", "-n", str(limit), ref or "HEAD"],
    )
    if result["returncode"] != 0:
        return {"status": 400, "payload": {"error": result["stderr"] or "Unable to read reflog."}}
    entries = []
    for line in result["stdout"].splitlines():
        if not line.strip():
            continue
        parts = line.split("\t")
        while len(parts) < 4:
            parts.append("")
        entries.append({"commit": parts[0], "selector": parts[1], "action": parts[2], "date": parts[3]})
    return {"status": 200, "payload": {"entries": entries}}


SUBMODULE_STATUS_WORDS = {"-": "not_initialized", "+": "modified", "U": "conflict"}


def list_submodules(repo_root):
    result = run_git_capture(repo_root, ["submodule", "status", "--recursive"])
    if result["returncode"] != 0:
        return {"status": 400, "payload": {"error": result["stderr"] or "Unable to list submodules."}}
    submodules = []
    for line in result["stdout"].splitlines():
        if not line.strip():
            continue
        state = line[0]
        rest = line[1:].strip()
        parts = rest.split(" ", 1)
        commit = parts[0] if len(parts) > 0 else ""
        remainder = parts[1] if len(parts) > 1 else ""
        describe = ""
        if " (" in remainder and remainder.endswith(")"):
            path, _, describe = remainder.partition(" (")
            describe = describe[:-1]
        else:
            path = remainder
        submodules.append({
            "path": path.strip(),
            "commit": commit,
            "status": SUBMODULE_STATUS_WORDS.get(state, "clean"),
            "describe": describe,
        })
    return {"status": 200, "payload": {"submodules": submodules}}


def update_submodules(repo_root, init):
    args = ["submodule", "update", "--recursive"]
    if init:
        args.append("--init")
    result = run_git_capture(repo_root, args)
    if result["returncode"] != 0:
        return {"status": 400, "payload": {"error": result["stderr"] or result["stdout"] or "Unable to update submodules."}}
    return list_submodules(repo_root)


def add_to_gitignore(repo_root, pattern):
    if not pattern or not pattern.strip():
        return {"status": 400, "payload": {"error": "A pattern is required."}}
    pattern = pattern.strip()
    gitignore_path = os.path.join(repo_root, ".gitignore")
    existing = ""
    if os.path.isfile(gitignore_path):
        with open(gitignore_path, "r") as f:
            existing = f.read()
    if pattern in existing.splitlines():
        return {"status": 200, "payload": {"message": pattern + " is already ignored.", "added": False}}
    with open(gitignore_path, "a") as f:
        if existing and not existing.endswith("\n"):
            f.write("\n")
        f.write(pattern + "\n")
    return {"status": 200, "payload": {"message": "Added " + pattern + " to .gitignore", "added": True}}


BLAME_COMMIT_HEADER_RE = re.compile(r"^([0-9a-f]{40}) (\d+) (\d+)(?: (\d+))?$")


def get_blame(repo_root, path, rev=None):
    if not path:
        return {"status": 400, "payload": {"error": "A file path is required."}}
    args = ["blame", "--porcelain"]
    if rev and rev.strip():
        args.append(rev.strip())
    args += ["--", path]
    result = run_git_capture(repo_root, args)
    if result["returncode"] != 0:
        return {"status": 400, "payload": {"error": result["stderr"] or "Unable to blame this file."}}

    lines = []
    commits = {}
    current_commit = None
    current_line_no = None
    for raw_line in result["stdout"].split("\n"):
        if raw_line.startswith("\t"):
            lines.append({"commit": current_commit, "line_no": current_line_no, "text": raw_line[1:]})
            continue
        header_match = BLAME_COMMIT_HEADER_RE.match(raw_line)
        if header_match:
            current_commit = header_match.group(1)
            current_line_no = int(header_match.group(3))
            commits.setdefault(current_commit, {})
            continue
        if current_commit is not None:
            if raw_line.startswith("author "):
                commits[current_commit]["author"] = raw_line[len("author "):]
            elif raw_line.startswith("author-time "):
                commits[current_commit]["author_time"] = raw_line[len("author-time "):]
            elif raw_line.startswith("summary "):
                commits[current_commit]["summary"] = raw_line[len("summary "):]

    for line in lines:
        info = commits.get(line["commit"], {})
        line["author"] = info.get("author", "")
        line["summary"] = info.get("summary", "")
        line["author_time"] = info.get("author_time", "")
    return {"status": 200, "payload": {"lines": lines}}


UNMERGED_STATUS_CODES = ("UU", "AA", "DD", "AU", "UA", "DU", "UD")


def get_conflict_status(repo_root):
    git_dir_result = run_git_capture(repo_root, ["rev-parse", "--git-dir"])
    git_dir = (
        os.path.join(repo_root, git_dir_result["stdout"].strip())
        if git_dir_result["returncode"] == 0
        else os.path.join(repo_root, ".git")
    )
    merging = os.path.isfile(os.path.join(git_dir, "MERGE_HEAD"))
    rebasing = os.path.isdir(os.path.join(git_dir, "rebase-merge")) or os.path.isdir(os.path.join(git_dir, "rebase-apply"))
    result = run_git_capture(repo_root, ["status", "--porcelain"])
    conflicted = []
    if result["returncode"] == 0:
        for line in result["stdout"].splitlines():
            if len(line) < 3:
                continue
            if line[0:2] in UNMERGED_STATUS_CODES:
                conflicted.append(line[3:])
    return {
        "status": 200,
        "payload": {
            "merging": merging,
            "rebasing": rebasing,
            "conflicted_files": conflicted,
        },
    }


def resolve_conflict(repo_root, path, resolution):
    if not path:
        return {"status": 400, "payload": {"error": "A file path is required."}}
    if resolution not in ("ours", "theirs"):
        return {"status": 400, "payload": {"error": "resolution must be 'ours' or 'theirs'."}}
    checkout_result = run_git_capture(repo_root, ["checkout", "--" + resolution, "--", path])
    if checkout_result["returncode"] != 0:
        return {"status": 400, "payload": {"error": checkout_result["stderr"] or "Unable to resolve conflict."}}
    add_result = run_git_capture(repo_root, ["add", "--", path])
    if add_result["returncode"] != 0:
        return {"status": 400, "payload": {"error": add_result["stderr"] or "Unable to stage resolved file."}}
    return get_conflict_status(repo_root)


def run_interactive_rebase_plan(repo_root, base, actions):
    if not base or not base.strip():
        return {"status": 400, "payload": {"error": "A base commit or branch is required."}}
    if not actions:
        return {"status": 400, "payload": {"error": "At least one commit action is required."}}
    lines = []
    for action in actions:
        verb = action.get("action", "pick")
        if verb not in ("pick", "squash", "drop"):
            return {"status": 400, "payload": {"error": "Unsupported rebase action: " + str(verb)}}
        commit = action.get("commit")
        if not commit:
            return {"status": 400, "payload": {"error": "Each action requires a commit."}}
        if verb == "drop":
            continue
        lines.append(verb + " " + commit)
    if not lines:
        return {"status": 400, "payload": {"error": "The rebase plan cannot drop every commit."}}
    todo_content = "\n".join(lines) + "\n"

    fd, todo_path = tempfile.mkstemp(prefix="gitpar-rebase-todo-")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(todo_content)
        env = dict(os.environ)
        env["GIT_SEQUENCE_EDITOR"] = "cp " + shlex.quote(todo_path)
        env["GIT_EDITOR"] = "true"
        process = subprocess.Popen(
            ["git", "-c", "color.ui=false", "rebase", "-i", base.strip()],
            cwd=repo_root,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=env,
        )
        stdout, stderr = process.communicate()
        if process.returncode != 0:
            return {
                "status": 409,
                "payload": {
                    "error": decode_output(stderr) or decode_output(stdout) or "Rebase failed. It may need manual conflict resolution.",
                },
            }
        return {"status": 200, "payload": {"message": decode_output(stdout) or "Rebase completed."}}
    finally:
        try:
            os.remove(todo_path)
        except OSError:
            pass


def get_repo_summary(repo_root, active=False):
    branch = "Detached"
    ahead = 0
    behind = 0
    staged_count = 0
    changed_count = 0
    untracked_count = 0
    try:
        git = subprocess.Popen(
            ["git", "-c", "color.ui=false", "status", "--short", "--branch"],
            cwd=repo_root,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        stdout, stderr = git.communicate()
        if git.returncode == 0:
            if sys.version > '3':
                stdout = codecs.decode(stdout, "utf-8")
            lines = stdout.splitlines()
            if len(lines) > 0 and lines[0].startswith("## "):
                branch_line = lines[0][3:]
                if "..." in branch_line:
                    branch = branch_line.split("...")[0]
                elif branch_line.startswith("HEAD"):
                    branch = "Detached"
                else:
                    branch = branch_line
                if "[" in branch_line and "]" in branch_line:
                    details = branch_line.split("[", 1)[1].split("]", 1)[0]
                    for item in details.split(","):
                        item = item.strip()
                        if item.startswith("ahead "):
                            ahead = int(item[6:])
                        elif item.startswith("behind "):
                            behind = int(item[7:])
            for line in lines[1:]:
                if line.startswith("??"):
                    untracked_count += 1
                    continue
                if len(line) < 2:
                    continue
                if line[0] not in [" ", "?"]:
                    staged_count += 1
                if line[1] not in [" ", "?"]:
                    changed_count += 1
    except Exception:
        pass
    return {
        "name": os.path.basename(repo_root) or repo_root,
        "path": repo_root,
        "active": active,
        "branch": branch,
        "ahead": ahead,
        "behind": behind,
        "staged_count": staged_count,
        "changed_count": changed_count,
        "untracked_count": untracked_count,
    }


def scan_workspace_repos(path, active_repo_root=None):
    if not path or not os.path.isdir(path):
        return []
    workspace_root = os.path.realpath(os.path.expanduser(path))
    candidates = [workspace_root]
    try:
        child_names = os.listdir(workspace_root)
    except OSError:
        child_names = []
    for child_name in child_names:
        child_path = os.path.join(workspace_root, child_name)
        if os.path.isdir(child_path):
            candidates.append(child_path)
    repo_roots = []
    seen = set()
    for candidate in candidates:
        repo_root = resolve_repo_root(candidate)
        if repo_root == os.path.realpath(candidate) and repo_root not in seen:
            seen.add(repo_root)
            repo_roots.append(repo_root)
    repo_roots.sort(key=lambda repo: (repo != active_repo_root, os.path.basename(repo).lower(), repo.lower()))
    return [get_repo_summary(repo_root, repo_root == active_repo_root) for repo_root in repo_roots]


def get_workspace_payload(workspace_root, active_repo_root=None):
    workspace_root = os.path.realpath(workspace_root) if workspace_root and os.path.isdir(workspace_root) else None
    return {
        "workspace_path": workspace_root,
        "workspace_repos": scan_workspace_repos(workspace_root, active_repo_root),
    }


def list_directory_entries(path, current_repo_root=None):
    if path is None:
        if current_repo_root is not None:
            path = os.path.dirname(current_repo_root)
        else:
            path = os.path.expanduser("~")
    path = os.path.realpath(os.path.expanduser(path))
    if not os.path.isdir(path):
        path = os.path.expanduser("~")
    entries = []
    try:
        dir_entries = os.listdir(path)
    except OSError:
        dir_entries = []
    for name in dir_entries:
        full_path = os.path.join(path, name)
        if os.path.isdir(full_path):
            entries.append({
                "name": name,
                "path": full_path,
                "is_repo": looks_like_git_root(full_path),
                "active": full_path == current_repo_root,
            })
    entries.sort(key=lambda entry: (not entry["is_repo"], entry["name"].lower()))
    parent_path = os.path.dirname(path) if os.path.dirname(path) != path else None
    return {
        "path": path,
        "parent_path": parent_path,
        "entries": entries,
    }




def get_setting_string(args, name, default=None):
    if vars(args)[name] is not None:
        return vars(args)[name]
    return read_config_string(name, default)




def get_setting_boolean(args, name, default=False):
    if vars(args)[name] is not None:
        return vars(args)[name]
    return read_config_boolean(name, default)




if __name__ == '__main__':
    parser = argparse.ArgumentParser(description = "Simple HTTP server for GitPar")
    parser.add_argument("--port", type = int, help = "server port")
    parser.add_argument("--repo-root", help = "repository root path. By default goes up a dir until a '.git' directory is found")
    parser.add_argument("--no-browser", dest = "nobrowser", action = 'store_const', const = True, help = "do not start web browser")

    args = parser.parse_args()

    if args.repo_root is None:
        args.repo_root = resolve_repo_root(os.path.abspath(os.getcwd()))
    else:
        args.repo_root = resolve_repo_root(os.path.abspath(args.repo_root))

    GitParRequestHandler.initialize(args.repo_root)

    args.port = get_setting_string(args, 'port', None)
    port = int(args.port) if args.port is not None else 8000
    # Always bind to loopback only: GitPar has no remote-access mode, so
    # nothing other than processes on this machine should ever reach it.
    host = "127.0.0.1"
    httpd = None
    while httpd is None:
        try:
            httpd = GitParHttpServer((host, port), GitParRequestHandler)
        except socket.error as e:
            if args.port is not None:
                sys.stderr.write("Port {} is already in use, try another one\n".format(port))
                sys.exit(2)
            else:
                sys.stderr.write("Port {} is already in use, trying another one\n".format(port))
                port += 1

    url = "http://{}:{}".format("localhost", port)
    print("Serving at {}".format(url))
    nobrowser = get_setting_boolean(args, "nobrowser")
    if not nobrowser:
        webbrowser.open(url)

    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        httpd.server_close()
        sys.exit(0)
