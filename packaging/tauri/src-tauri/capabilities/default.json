{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the git-webui desktop shell's single window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "git-webui-server",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
