{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "git-webui",
  "version": "1.3.0",
  "identifier": "com.git-webui.desktop",
  "build": {
    "frontendDist": "../dist-shell"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "git-webui",
        "width": 1280,
        "height": 860,
        "minWidth": 720,
        "minHeight": 480,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/git-webui-server"
    ]
  }
}
